# --- Layer 2: Claude classification agent (required) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-4-5-20250929.
CLASSIFIER_MODEL=claude-sonnet-4-5-20250929

# --- Data layer ---
# Leave BOTH unset to use the zero-config local SQLite store at ./data/checks.db.
# Set BOTH to switch to Supabase Postgres with no code changes.
# Apply supabase/migrations/0001_init.sql to the project first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Privacy ---
# Salt for hashing input text before storage. CHANGE THIS IN PRODUCTION.
# Rotating it makes previously stored hashes unlinkable, which is intentional.
HASH_SALT=change-me-in-production

# --- Server ---
PORT=3600

# Copy to .env.local and fill in. Everything below is already set to the
# values the published results were measured on — change them only deliberately.

# --- Layer 2: Claude classification agent (required) ---
# Without this the app still runs, but every check falls back to the rules
# layer and says so. Classification quality is much lower.
ANTHROPIC_API_KEY=sk-ant-...

# --- Classifier tuning ---
# These two defaults MATTER: TEST_RESULTS.md (16/16, ~6s per check) was
# measured at exactly these values. Changing either invalidates that evidence.
#
# Model. Code default is claude-opus-5; pinned here so it's explicit.
CLASSIFIER_MODEL=claude-opus-5
#
# Effort. The code default is `medium` (fails safe toward more thinking), but
# `low` is 4-5x faster at identical accuracy on the 16-fixture suite and is
# what the ~6s figure comes from. Leave this at low unless you re-run the suite.
CLASSIFIER_EFFORT=low
#
# Fall back to the rules layer if the API hasn't answered in this long.
CLASSIFIER_TIMEOUT_MS=20000

# --- Privacy ---
# Salt for hashing input text before storage. CHANGE THIS — the default
# placeholder makes hashes predictable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Rotating it makes previously stored hashes unlinkable, which is intentional.
HASH_SALT=change-me-in-production

# --- Data layer ---
# Leave BOTH unset for the zero-config local SQLite store at ./data/checks.db.
# Set BOTH to switch to Supabase Postgres with no code changes — apply
# supabase/migrations/0001_init.sql first.
# On Vercel an in-memory store is selected automatically (ephemeral filesystem).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server ---
PORT=3600
# CORS_ORIGIN=*
# LOG_LEVEL=info

# --- Rate limiting (optional; defaults shown) ---
# Set TRUST_PROXY=1 when self-hosting behind a reverse proxy (Railway, Render,
# Fly, nginx) so the limiter reads the forwarded hop your proxy appended.
# Without it — and without a proxy — forwarding headers are ignored, because
# they are spoofable user input. On Vercel this is detected automatically.
# TRUST_PROXY=1
# RATE_LIMIT_MAX=12            # per IP per window, for checks that hit the API
# RATE_LIMIT_CACHED_MAX=200    # per IP per window, for cache hits (they cost nothing)
# RATE_LIMIT_GLOBAL_MAX=240    # across all callers — the cost circuit-breaker
# RATE_LIMIT_WINDOW_MS=60000

# --- Verdict cache (optional; defaults shown) ---
# CACHE_TTL_MS=3600000           # a real verdict
# CACHE_FALLBACK_TTL_MS=60000    # a rules-only verdict, kept brief on purpose
# CACHE_MAX_ENTRIES=500
